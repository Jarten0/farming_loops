[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 Top_Color : source_color;
uniform vec4 Bottom_Color : source_color;
uniform float Horizon_Height;
uniform float Horizon_Sharpness = 1.0;



void fragment() {
// ColorParameter:4
	vec4 n_out4p0 = Top_Color;


// ColorParameter:5
	vec4 n_out5p0 = Bottom_Color;


// Input:2
	vec2 n_out2p0 = UV;


// VectorDecompose:3
	float n_out3p0 = n_out2p0.x;
	float n_out3p1 = n_out2p0.y;


// FloatParameter:9
	float n_out9p0 = Horizon_Height;


// FloatOp:7
	float n_out7p0 = n_out3p1 + n_out9p0;


// FloatParameter:10
	float n_out10p0 = Horizon_Sharpness;


// FloatOp:11
	float n_out11p0 = n_out7p0 * n_out10p0;


// Mix:6
	vec3 n_out6p0 = mix(vec3(n_out4p0.xyz), vec3(n_out5p0.xyz), vec3(n_out11p0));


// Output:0
	COLOR.rgb = n_out6p0;


}
"
